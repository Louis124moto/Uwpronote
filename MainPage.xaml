<Page
    x:Class="PronoteLumia.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Pivot Title="PRONOTE LUMIA (LOCAL)">

            <!-- Onglet 1 : Devoirs (Triés par date) -->
            <PivotItem Header="devoirs">
                <Grid>
                    <ProgressRing x:Name="Loader" IsActive="False" Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <ListView x:Name="HomeworkListView" Margin="10">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" CornerRadius="4" Padding="4" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding FormattedDate}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Subject}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- Onglet 2 : Emploi du temps -->
            <PivotItem Header="emploi du temps">
                <ListView x:Name="ScheduleListView" Margin="10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8">
                                <TextBlock Text="{Binding TimeSlot}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Room}" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Onglet 3 : Connexion & Stockage -->
            <PivotItem Header="compte">
                <ScrollViewer>
                    <StackPanel Margin="15" Spacing="10">
                        <TextBox x:Name="TxtPronoteUrl" Header="URL de votre serveur Pronote"/>
                        <TextBox x:Name="TxtUsername" Header="Identifiant"/>
                        <PasswordBox x:Name="TxtPassword" Header="Mot de passe"/>
                        <Button Content="Connexion directe et Sauvegarde" Click="BtnLogin_Click" HorizontalAlignment="Stretch" Margin="0,15,0,0"/>
                        <TextBlock x:Name="TxtStatus" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>